{
  "name": "distributed-payments-system",
  "version": "1.0.0",
  "description": "",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "dev:gateway": "npm run dev --workspace=@dps/api-gateway",
    "dev:users": "npm run dev --workspace=@dps/user-management-service",
    "dev:wallet": "npm run dev --workspace=@dps/distributed-wallet-engine",
    "docker:up": "docker compose -f docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f docker/docker-compose.yml down"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "tsx": "^4.19.0",
    "@types/node": "^22.0.0"
  }
}
